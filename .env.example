# LLM Settings
LLM_ACCESS_TOKEN=sk-xxx
LLM_URI_BASE=https://openrouter.ai/api/v1
LLM_MODEL=qwen/qwen3.6-plus:free
# LLM_SYSTEM_PROMPT=prompts/system.erb

# Language Settings
# Language code for generated output (e.g., ja, en, zh, ko)
# LANGUAGE=ja

# Trello Settings
# https://trello.com/app-key/
TRELLO_DEVELOPER_PUBLIC_KEY=xxx
# https://trello.com/1/authorize?expiration=never&scope=read,write&response_type=token&key=[YOUR TRELLO_DEVELOPER_PUBLIC_KEY]
TRELLO_MEMBER_TOKEN=your_trello_member_token
# https://trello.com/c/[YOURS]/board-name.json
TRELLO_LIST_ID=your_target_list_id
